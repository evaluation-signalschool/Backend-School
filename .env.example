# ==========================================
#  Backend-School Environment Variables
# คัดลอกไฟล์นี้เป็น .env แล้วกรอกข้อมูลจริงสำหรับการใช้งาน
# ==========================================

# Server Configuration
PORT=3000

# Database Configuration (MySQL on Aiven Cloud / Local MySQL)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_password_here
DB_NAME=defaultdb

# Database SSL CA Certificate (Base64 string หรือ path ถ้าใช้ Aiven Cloud)
# กรณีรัน Local สามารถเว้นว่างหรือปล่อยไว้ได้
DB_CA_CERT=

# Security & Authentication
JWT_SECRET=your_jwt_secret_key_change_in_production

# Cloudinary Storage (สำหรับอัปโหลดรูปภาพและไฟล์สื่อ)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Google API & Drive Integration
GOOGLE_SERVICE_ACCOUNT_KEY_FILE=config/google-key.json
GOOGLE_DRIVE_FOLDER_ID=your_google_drive_folder_id
GOOGLE_CLIENT_ID=your_google_oauth_client_id.apps.googleusercontent.com
